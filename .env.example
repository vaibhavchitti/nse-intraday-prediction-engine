# .env example

# Optional broker integration values. None are required for the offline, historical,
# and synthetic-data research foundation.
PROJECT_NAME=nse_intraday_prediction_engine
DATA_DIR=data
RAW_DATA_DIR=data/raw
MARKET_TIMEZONE=Asia/Kolkata
TRADING_START_HOUR=9
TRADING_START_MINUTE=15
TRADING_END_HOUR=15
TRADING_END_MINUTE=30
MAX_STALE_MINUTES=10
LOOKBACK_MINUTES=60
SYNTHETIC_SEED=42
FYERS_API_KEY=
FYERS_API_SECRET=
FYERS_ACCESS_TOKEN=
FYERS_BASE_URL=https://api.fyers.in
UNIVERSE=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,SBIN
