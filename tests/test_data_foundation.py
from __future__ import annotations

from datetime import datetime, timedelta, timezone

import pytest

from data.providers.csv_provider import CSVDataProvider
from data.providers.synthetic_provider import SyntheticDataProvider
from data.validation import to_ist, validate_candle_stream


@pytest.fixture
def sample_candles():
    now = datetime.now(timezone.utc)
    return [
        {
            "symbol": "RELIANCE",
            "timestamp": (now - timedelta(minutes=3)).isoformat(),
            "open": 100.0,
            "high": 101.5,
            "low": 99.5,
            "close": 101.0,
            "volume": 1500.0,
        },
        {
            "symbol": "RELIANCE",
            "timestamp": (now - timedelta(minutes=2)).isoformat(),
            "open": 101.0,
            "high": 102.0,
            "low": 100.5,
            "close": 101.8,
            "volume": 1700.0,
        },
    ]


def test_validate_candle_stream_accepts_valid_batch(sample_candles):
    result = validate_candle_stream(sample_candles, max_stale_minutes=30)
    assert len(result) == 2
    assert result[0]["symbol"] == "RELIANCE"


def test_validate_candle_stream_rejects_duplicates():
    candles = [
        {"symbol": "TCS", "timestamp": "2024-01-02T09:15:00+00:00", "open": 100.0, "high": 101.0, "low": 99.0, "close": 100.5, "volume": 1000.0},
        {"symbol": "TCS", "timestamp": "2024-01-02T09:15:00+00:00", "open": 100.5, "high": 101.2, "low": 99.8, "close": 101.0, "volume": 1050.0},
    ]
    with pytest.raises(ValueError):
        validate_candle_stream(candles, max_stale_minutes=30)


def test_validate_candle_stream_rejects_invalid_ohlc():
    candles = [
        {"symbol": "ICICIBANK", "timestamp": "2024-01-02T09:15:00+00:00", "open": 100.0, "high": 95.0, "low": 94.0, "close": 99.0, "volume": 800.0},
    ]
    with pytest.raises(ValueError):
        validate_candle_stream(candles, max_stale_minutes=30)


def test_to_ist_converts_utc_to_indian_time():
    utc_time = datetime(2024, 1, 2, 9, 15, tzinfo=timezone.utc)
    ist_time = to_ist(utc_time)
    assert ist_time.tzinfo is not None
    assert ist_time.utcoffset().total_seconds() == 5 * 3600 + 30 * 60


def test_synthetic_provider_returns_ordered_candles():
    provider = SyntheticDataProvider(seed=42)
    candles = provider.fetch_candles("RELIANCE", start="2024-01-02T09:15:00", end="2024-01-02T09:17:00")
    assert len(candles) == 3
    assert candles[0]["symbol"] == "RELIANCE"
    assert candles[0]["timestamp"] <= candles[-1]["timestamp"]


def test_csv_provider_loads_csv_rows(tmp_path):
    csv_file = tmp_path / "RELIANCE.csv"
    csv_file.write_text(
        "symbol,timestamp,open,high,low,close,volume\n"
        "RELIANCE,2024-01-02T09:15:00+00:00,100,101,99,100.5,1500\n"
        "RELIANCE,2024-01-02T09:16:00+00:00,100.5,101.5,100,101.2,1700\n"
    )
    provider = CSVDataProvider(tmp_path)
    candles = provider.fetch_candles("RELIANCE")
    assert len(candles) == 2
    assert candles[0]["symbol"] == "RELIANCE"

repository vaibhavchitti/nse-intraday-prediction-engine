from __future__ import annotations

from datetime import datetime, timedelta
from typing import List

import numpy as np

from data.validation import validate_candle_stream


class SyntheticDataProvider:
    """Deterministic synthetic candle generator for offline tests only."""

    def __init__(self, seed: int = 42):
        self.seed = seed

    def fetch_candles(self, symbol: str, interval: str = "1min", start: str | None = None, end: str | None = None) -> List[dict]:
        rng = np.random.default_rng(self.seed)
        if start is None:
            start_dt = datetime(2024, 1, 2, 9, 15)
        else:
            start_dt = datetime.fromisoformat(start)
        if end is None:
            end_dt = start_dt + timedelta(minutes=120)
        else:
            end_dt = datetime.fromisoformat(end)

        candles: List[dict] = []
        current = start_dt
        base_price = 100.0
        while current <= end_dt:
            open_price = base_price
            drift = rng.normal(0.0, 0.0015)
            close_price = max(1.0, open_price * (1 + drift))
            high_price = max(open_price, close_price) * (1 + abs(rng.normal(0.0, 0.002)))
            low_price = min(open_price, close_price) * (1 - abs(rng.normal(0.0, 0.002)))
            volume = max(0.0, rng.normal(2000, 400))
            candles.append(
                {
                    "symbol": symbol.upper(),
                    "timestamp": current.isoformat(),
                    "open": round(open_price, 2),
                    "high": round(high_price, 2),
                    "low": round(low_price, 2),
                    "close": round(close_price, 2),
                    "volume": volume,
                }
            )
            base_price = close_price
            current += timedelta(minutes=1)

        return validate_candle_stream(candles)

    def fetch_latest_candle(self, symbol: str, interval: str = "1min") -> dict | None:
        candles = self.fetch_candles(symbol=symbol, interval=interval)
        return candles[-1] if candles else None


__all__ = ["SyntheticDataProvider"]
